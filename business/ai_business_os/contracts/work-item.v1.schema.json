{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-agent:schema:ai-business-os:work-item:v1",
  "title": "Hermes AI Business OS WorkItem v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_version", "work_item_id", "title", "owner",
    "effect_level", "acceptance_criteria", "idempotency_key", "audit_ref"
  ],
  "properties": {
    "schema_version": {"const": "hermes.ai_business_os.work_item.v1"},
    "manifest_version": {"const": 1},
    "work_item_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "effect_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "idempotency_key": {"type": "string", "minLength": 1},
    "audit_ref": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "parent_artifact_ref": {"type": "string", "minLength": 1},
    "requested_action": {"type": "string", "minLength": 1}
  }
}

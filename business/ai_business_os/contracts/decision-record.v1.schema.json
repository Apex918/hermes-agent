{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-agent:schema:ai-business-os:decision-record:v1",
  "title": "Hermes AI Business OS DecisionRecord v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "hermes.ai_business_os.decision_record.v1"},
    "manifest_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "owner": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rights": {"$ref": "#/$defs/rights"},
    "freshness": {"$ref": "#/$defs/freshness"},
    "license": {"type": "string", "minLength": 1},
    "role": {"type": "string"},
    "verdict": {"type": "string"},
    "reason": {"type": "string"},
    "evidence": {"type": "array"},
    "handoff": {"type": "object"},
    "fail_closed_on": {"type": "array"}
  },
  "oneOf": [
    {"type": "object", "required": ["schema_version", "manifest_version", "decision_id", "owner", "approver", "review_date", "decision"]},
    {"type": "object", "required": ["schema_version", "manifest_version", "decision_id", "decision", "rights", "freshness", "license"]}
  ],
  "$defs": {
    "freshness": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["reviewed_at"], "properties": {
          "reviewed_at": {"type": "string", "minLength": 1},
          "max_age_days": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["fresh", "stale", "expired", "missing", "unknown"]}
        }},
        {"type": "string", "enum": ["fresh", "stale", "expired", "missing", "unknown"]}
      ]
    },
    "rights": {
      "type": "object", "additionalProperties": false, "required": ["scope", "asset_policy", "publish"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "asset_policy": {"type": "string", "enum": ["internal-only", "project-only", "restricted-publish"]},
        "publish": {"type": "boolean"}
      }
    }
  }
}

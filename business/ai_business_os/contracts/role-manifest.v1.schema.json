{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-agent:schema:ai-business-os:role-manifest:v1",
  "title": "Hermes AI Business OS Role Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "role",
    "title",
    "toolsets",
    "rights",
    "freshness",
    "license"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes.ai_business_os.role_manifest.v1"
    },
    "manifest_version": {
      "const": 1
    },
    "role": {
      "enum": [
        "ceo",
        "cfo",
        "coo",
        "cmo",
        "cro",
        "cpo",
        "cto",
        "ciso",
        "chro",
        "gc",
        "cco",
        "cdo"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "toolsets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "asset_policy",
        "publish"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "asset_policy": {
          "type": "string",
          "enum": [
            "internal-only",
            "project-only",
            "restricted-publish"
          ]
        },
        "publish": {
          "type": "boolean"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_at"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

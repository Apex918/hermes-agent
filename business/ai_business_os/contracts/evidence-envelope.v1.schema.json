{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-agent:schema:ai-business-os:evidence-envelope:v1",
  "title": "Hermes AI Business OS EvidenceEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "hermes.ai_business_os.evidence_envelope.v1"},
    "manifest_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "source": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 1},
    "freshness": {"$ref": "#/$defs/freshness"},
    "license_or_entitlement": {"type": "string", "minLength": 1},
    "pii_class": {"type": "string", "minLength": 1, "enum": ["none", "low", "moderate", "high", "restricted", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "allowed_use": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]},
    "hash": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_item"}},
    "rights": {"$ref": "#/$defs/rights"},
    "license": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "payload": {"type": "object"},
    "_legacy": {"type": "boolean"}
  },
  "oneOf": [
    {"type": "object", "required": ["schema_version", "manifest_version", "evidence_id", "source", "source_id", "as_of", "freshness", "license_or_entitlement", "pii_class", "confidence", "allowed_use", "hash"]},
    {"type": "object", "required": ["schema_version", "manifest_version", "evidence_id", "evidence", "rights", "freshness", "license"]}
  ],
  "$defs": {
    "freshness": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["reviewed_at"], "properties": {
          "reviewed_at": {"type": "string", "minLength": 1},
          "max_age_days": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["fresh", "stale", "expired", "missing", "unknown"]}
        }},
        {"type": "string", "enum": ["fresh", "stale", "expired", "missing", "unknown"]}
      ]
    },
    "rights": {
      "type": "object", "additionalProperties": false, "required": ["scope", "asset_policy", "publish"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "asset_policy": {"type": "string", "enum": ["internal-only", "project-only", "restricted-publish"]},
        "publish": {"type": "boolean"}
      }
    },
    "evidence_item": {
      "type": "object", "additionalProperties": false, "required": ["kind", "summary"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-agent:schema:ai-business-os:evidence-envelope:v1",
  "title": "Hermes AI Business OS EvidenceEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "evidence_id",
    "evidence",
    "rights",
    "freshness",
    "license"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes.ai_business_os.evidence_envelope.v1"
    },
    "manifest_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "asset_policy",
        "publish"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "asset_policy": {
          "type": "string",
          "enum": [
            "internal-only",
            "project-only",
            "restricted-publish"
          ]
        },
        "publish": {
          "type": "boolean"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_at"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

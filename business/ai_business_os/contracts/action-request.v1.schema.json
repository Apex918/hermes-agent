{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-agent:schema:ai-business-os:action-request:v1",
  "title": "Hermes AI Business OS ActionRequest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "hermes.ai_business_os.action_request.v1"},
    "manifest_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "owner": {"type": "string", "minLength": 1},
    "effect_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "preview": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
    "rollback": {"type": "object"},
    "approvers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "idempotency_key": {"type": "string", "minLength": 1},
    "audit_ref": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rights": {"$ref": "#/$defs/rights"},
    "freshness": {"$ref": "#/$defs/freshness"},
    "license": {"type": "string", "minLength": 1},
    "role": {"type": "string"},
    "summary": {"type": "string"},
    "evidence": {"type": "array"},
    "gaps": {"type": "array"},
    "next_cards": {"type": "array"},
    "kanban_handoff": {"type": "string"}
  },
  "oneOf": [
    {"type": "object", "required": ["schema_version", "manifest_version", "request_id", "owner", "effect_level", "preview", "rollback", "approvers", "idempotency_key", "audit_ref", "action"]},
    {"type": "object", "required": ["schema_version", "manifest_version", "request_id", "action", "rights", "freshness", "license"]}
  ],
  "$defs": {
    "freshness": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["reviewed_at"], "properties": {
          "reviewed_at": {"type": "string", "minLength": 1},
          "max_age_days": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["fresh", "stale", "expired", "missing", "unknown"]}
        }},
        {"type": "string", "enum": ["fresh", "stale", "expired", "missing", "unknown"]}
      ]
    },
    "rights": {
      "type": "object", "additionalProperties": false, "required": ["scope", "asset_policy", "publish"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "asset_policy": {"type": "string", "enum": ["internal-only", "project-only", "restricted-publish"]},
        "publish": {"type": "boolean"}
      }
    }
  }
}
